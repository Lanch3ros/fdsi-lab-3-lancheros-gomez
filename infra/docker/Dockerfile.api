FROM python:3.12-slim
WORKDIR /srv
RUN pip install --no-cache-dir flask==3.0.3 gunicorn==22.0.0
COPY app/api/ /srv/
ENV HARDENED=0
EXPOSE 8000
# --access-logfile - envia el log de gunicorn a stdout para el Blue Team.
# --workers 1 es deliberado: el registro de auditoria del prototipo vive en
# memoria del proceso. Con varios workers cada uno tendria su propia lista y
# GET /api/v1/audit devolveria un fragmento distinto en cada peticion, lo que
# haria la evidencia irreproducible. Un almacen compartido es materia de un
# laboratorio posterior.
CMD ["sh","-c","gunicorn --bind 0.0.0.0:8000 --access-logfile - --workers 1 app:app"]
